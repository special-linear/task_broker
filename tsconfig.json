{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  },
  "include": ["src/worker", "src/shared", "tests", "scripts", "*.ts"],
  "exclude": ["src/web", "tests/browser"]
}
